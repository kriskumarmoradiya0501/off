@model User
@{
    ViewData["Title"] = "Home Page";
    Layout = "../Shared/_UserLayout";
}


<div class="container mt-3">

    <h2>
        User CRUD
    </h2>
    
    <div class="container mt-5">
        <div>
            <button id="btnAdd" class="btn btn-primary">Add User</button>
        </div>
   
        <div>
            <h2 id="form-title">Add User</h2>
            <form class="" id="form" asp-action="AddUser" asp-controller="User" method="post">

                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                
                <input type="hidden" id="Id" name="Id" value="0" />
                
                <div class="mt-3">
                    <lable for=name>Name</lable>
                    <input class="form-control" type="text" asp-for="Name" placeholder="Enter Your Name" id="name"
                           name="Name" />
                    <span asp-validation-for="Name" class="text-danger"></span>

                </div>
                <div class="mt-3">
                    <lable for=email>Email</lable>
                    <input class="form-control" type="text" asp-for="Email" placeholder="Enter Your Email" id="email"
                           name="Email" />
                    <span asp-validation-for="Email" class="text-danger"></span>

                </div>
                <div class="mt-3">
                    <lable for=psw>Password</lable>
                    <input class="form-control" type="password" asp-for="Password" placeholder="Enter Your Password"
                           id="psw" name="Password" />
                    <span asp-validation-for="Password" class="text-danger"></span>

                </div>

                <div class="d-flex justify-content-center mt-3">
                    <button id="form-btn" class="btn btn-primary" type="submit">Add User</button>
                </div>
            </form>
        </div>
    </div>

    <div class="mt-5 mb-5"></div>

    
    <table class="table table-striped table-hover table-bordered" cellpadding="8">
        <thead>
            <tr>
                <th>
                    User Id
                </th>
                <th>
                    User Name
                </th>
                <th>
                    User Email
                </th>
                <th>
                    Actions
                </th>
            </tr>
        </thead>
        <tbody id="tbodyData" style="">
            
        </tbody>

    </table>
</div>
@section Scripts {
    <script>
        $(document).ready(function () {
            
            
            loaddata();


            $('#btnAdd').click(function () {

                clear();

                $('#form-title').text("Add User");

                $('#form-btn').text("Save User");

            });

 
            // Save button
            $('#form').submit(function (e) {

                e.preventDefault();

                saveUser();

            }); 
             
             


       

              
            });


        function loaddata() {
            $.ajax(
                {
                    url: "getall",
                    type: "GET",
                    success: (response) => {

                        var users = response.data.result;
                        
                        $("#tbodyData").empty();
                            
                        $.each(users, (index, user) => {
                            $("#tbodyData").append(`
                                                    <tr>
                                            <td>${user.id}</td>
                                            <td>${user.name}</td>
                                            <td>${user.email}</td>
                                            <td>
                                             <button 
                                    type="button"
                                    class="btn btn-secondary"
                                    onclick="edituser(${user.id})">
                                    Edit
                                </button>

                                <button 
                                    type="button"
                                    class="btn btn-danger"
                                    onclick="deleteUser(${user.id})">
                                    Delete
                                </button>
                                            </td>
                                        </tr>`);
                        });
                    },
                    error: (err) => {
                        console.log(err);
                    }
                });
        }

        function edituser(id) {
            $.ajax({

                url: `getbyid/${id}`,
                type: "GET",
                success: (res) => {
                    var user = res.data;
                    $("#id").val(user.id);
                    $("#name").val(user.name);
                    $("#email").val(user.email);
                    $("#psw").val(user.password);
                    $("#form-title").text("Edit User");
                    $("#form-btn").text("Edit User");



                },
                error: (err) => {
                    console.log(err);
                }

            });
        }

        function saveuser() {
            $.ajax({
                url: `save`,
                type: "POST",
                data: $("#form").serialize(),
                success: (res) => {
                    if (res.success) {
                        alert(res.messeage);
                        clear();
                        loaddata();
                    }
                    else {
                        alert(res.messeage);
                    }
                },
                error: (err) => {
                    console.log(err);
                }
            });
        }
        
        function clear() {
            $("#name").val("");
            $("#email").val("");
            $("#psw").val ("");
        }
        
        function deleteUser(id) {

            if (!confirm("Are you sure?")) {
                return;
            }

            $.ajax({

                url: '/User/Delete/' + id,

                type: 'DELETE',

                success: function (response) {

                    if (response.success) {

                        loadUsers();

                    }

                },

                error: function (error) {

                    console.log(error);

                }

            });

        }
        

    </script>
    
}

@model vm_Login
@{
    ViewData["Title"] = "Home Page";
}

<div class="container mt-5">
   <h3>Admin page</h3>

   
   <div>
      <form class="" asp-action="Admin" asp-controller="Home" method="post">
         
         <div asp-validation-summary="ModelOnly" class="text-danger"></div>

         <div class="mt-3">
            <lable for=email>Email</lable>
            <input class="form-control" type="text" asp-for="Email" placeholder="Enter Your Email" id="email" />
            <span asp-validation-for="Email" class="text-danger"></span>

         </div>
         <div class="mt-3">
            <lable for=psw>Password</lable>
            <input class="form-control" type="password" asp-for="Password" placeholder="Enter Your Password" id="psw" />
            <span asp-validation-for="Password" class="text-danger"></span>

         </div>
         <div class="d-flex justify-content-center mt-3" >
            <button class="btn btn-primary" type="submit">Login Admin</button>
         </div>
      </form>
   </div>
</div>

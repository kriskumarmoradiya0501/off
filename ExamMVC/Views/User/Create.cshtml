@model ExamMVC.t_User4;

<h2>Create User</h2>

<form asp-action="Add" asp-controller="User" method="post" enctype="multipart/form-data">
    <div>
        <label asp-for="c_name"></label>
        <input asp-for="c_name">
        <span asp-validation-for="c_name"></span>
    </div>
    <br>
    <div>
        <label asp-for="c_email"></label>
        <input asp-for="c_email" />
        <span asp-validation-for="c_email"></span>
    </div>

    <br />

    <div>
        <label asp-for="c_mobile"></label>
        <input asp-for="c_mobile" />
        <span asp-validation-for="c_mobile"></span>
    </div>

    <br />

    <div>
        <label asp-for="c_password"></label>
        <input asp-for="c_password" />
        <span asp-validation-for="c_password"></span>
    </div>

    <br />

    <div>
        <label asp-for="c_confirm_password"></label>
        <input asp-for="c_confirm_password" />
        <span asp-validation-for="c_confirm_password"></span>
    </div>

    <br />

    <div>
        <label> Gender </label>
        <input type="radio" asp-for="c_gender" value="Male"> Male
        <input type="radio" asp-for="c_gender" value="Female">Female
        <input type="radio" asp-for="c_gender" value="Other">Other

        <span asp-validation-for="c_gender"></span>
    </div>
    <br />

    <div>
        <label asp-for="c_age"></label>
        <input asp-for="c_age" type="number" />
        <span asp-validation-for="c_age"></span>
    </div>

    <br />

    <div>
        <label asp-for="c_address"></label>
        <textarea asp-for="c_address"></textarea>
        <span asp-validation-for="c_address"></span>
    </div>

    <div>
        <label asp-for="c_departmentid">Department</label>
        <select asp-for="c_departmentid">
            <option value="">--Select Department--</option>
            @foreach (var department in ViewBag.Departments)
            {
                <option value="@department.c_departmentid">@department.c_departmentname</option>
            }
        </select>
        <span asp-validation-for="c_departmentid"></span>

    </div>
    <br>
    <div>
        <label asp-for="c_dob"></label>
        <input type="date" asp-for="c_dob">
        <span asp-validation-for="c_dob"></span>
    </div>
    <br>
    <div>
        <label asp-for="c_status">Status</label>

        <select asp-for="c_status">
            <option value="true">Active</option>
            <option value="false">Inactive</option>
        </select>
    </div>



    <div>
        <label>Hobbies</label>

        <br>

        <input type="checkbox" name="c_hobbyList" value="reading"> reading
        <br>
        <input type="checkbox" name="c_hobbyList" value="Coding"> Coding
        <br>
        <input type="checkbox" name="c_hobbyList" value="Cricket"> Cricket
        <br>
        <input type="checkbox" name="c_hobbyList" value="Music"> Music

        <input type="hidden" name="c_hobbies" value="0">
        <input type="hidden" name="c_image" value="0">
    </div>

    <br>

    <div>
        <label asp-for="c_imageFile">Profile Image</label>

        <input asp-for="c_imageFile" type="file" accept="image/*">
    </div>

    <button type="submit">Save User</button>



</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}